# ── Required ────────────────────────────────────────────────────────────────
# Password for the bundled PostgreSQL database (change it!)
POSTGRES_PASSWORD=changeme-please

# 32-byte hex key used to encrypt connector configs at rest.
# Generate one:  openssl rand -hex 32
# If left empty, a key is auto-generated into /app/data/master.key on first boot.
MASTER_ENCRYPTION_KEY=

# Secret used to sign session cookies. Empty = random per boot (logs everyone out).
SESSION_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Host port for the web UI + MCP endpoint
APP_PORT=3000
# Max log lines kept per connector (ring buffer)
LOG_RETENTION_LINES=5000
# Log rows older than this many days are pruned
LOG_RETENTION_DAYS=7
# Optional: POST a JSON alert here when a connector enters error state
# (works with Slack, Discord, Teams or any generic webhook receiver)
ERROR_WEBHOOK_URL=
